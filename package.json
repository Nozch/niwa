{
  "name": "digital-garden-front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "astro dev",
    "typecheck": "astro check",
    "test": "vitest run tests/schema.test.ts tests/related.test.ts tests/editor-store.test.ts tests/search-palette.test.ts tests/record-shape.test.ts tests/public-snapshot.test.ts",
    "test:smoke": "vitest run tests/build.test.ts",
    "lint:content": "node --import tsx scripts/content-lint.ts",
    "build:site": "astro build",
    "index:search": "pagefind --site dist",
    "build": "pnpm run typecheck && pnpm run test && pnpm run lint:content && pnpm run build:site && pnpm run index:search && pnpm run test:smoke",
    "preview": "astro preview",
    "release:public": "node --import tsx scripts/release-public.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "4.3.6",
    "@astrojs/rss": "4.0.12",
    "@astrojs/sitemap": "3.6.0",
    "@astrojs/svelte": "7.2.3",
    "astro": "5.16.6",
    "svelte": "5.39.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.5",
    "@types/node": "24.3.0",
    "@types/unist": "3.0.3",
    "gray-matter": "4.0.3",
    "pagefind": "1.3.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.0.0",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@11.7.0"
}
