{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "astro-dev",
      "runtimeExecutable": "zsh",
      "runtimeArgs": ["-c", "PATH=$HOME/.nvm/versions/node/v22.19.0/bin:$PATH pnpm exec astro dev --port ${PORT:-4321}"],
      "port": 4321,
      "autoPort": true
    },
    {
      "name": "astro-preview",
      "runtimeExecutable": "zsh",
      "runtimeArgs": ["-c", "PATH=$HOME/.nvm/versions/node/v22.19.0/bin:$PATH pnpm exec astro preview --port ${PORT:-4322}"],
      "port": 4322,
      "autoPort": true
    }
  ]
}
