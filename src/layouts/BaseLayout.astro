---
import SearchPalette from '@/components/SearchPalette.svelte';
import Sidebar from '@/components/Sidebar.astro';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  navigation?: {
    all: number;
    diary: number;
    project: number;
    tags: { name: string; count: number }[];
  };
  canonicalPath?: string;
  pagefindBody?: boolean;
  pagefindMeta?: Record<string, string>;
  jsonLd?: Record<string, unknown>;
  /** 共有時のカード画像。未指定ならサイト共通の1枚。記事別画像を入れるときはここへ渡す。 */
  ogImage?: string;
}

// サイト共通の共有カード画像。実体は scripts/card-source/ の3Dレンダリングを 1200×630 に切り出したもの。
// 階調の多い写真的な絵なので PNG ではなく JPEG にしている（PNGだと同じ見た目で10倍近く重くなり、
// クローラが取得しきれずカードが出ないことがある）。
// width/height を先に宣言しておかないと、クローラが画像を取り終えるまでカードの形が決まらず、
// 初回の共有で画像が出ないことがある。差し替えるときはこの寸法と実物を必ず一致させる。
const OG_IMAGE = { path: '/og.jpg', width: '1200', height: '630', alt: '白砂に砂紋を描き、石を据えた枯山水の盆庭' } as const;

const {
  title = '庭 Niwa',
  description = '考えを育て、つながりを眺めるデジタルガーデン。',
  navigation = { all: 0, diary: 0, project: 0, tags: [] },
  canonicalPath = Astro.url.pathname,
  pagefindBody = false,
  pagefindMeta = {},
  jsonLd,
  ogImage = OG_IMAGE.path,
} = Astro.props;
const pageTitle = title === '庭 Niwa' ? title : `${title} | 庭 Niwa`;
const canonical = new URL(canonicalPath, Astro.site);
// og:image は相対パスだとクローラ側で解決できないことがあるので、canonical と同じく
// SITE_URL 起点の絶対URLにする。
const ogImageUrl = new URL(ogImage, Astro.site);
// 配色テーマ。'stationery' = 文房具的な光沢とミント(本則) / 'yugen' = 淡い・幽玄(試作、保留中)。
// この1語で全体が切り替わる(stationery側の定義は global.css の [data-theme='stationery'])。
const theme: 'yugen' | 'stationery' = 'stationery';
---

<!doctype html>
<html lang="ja" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="庭 Niwa" href="/rss.xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content={jsonLd ? 'article' : 'website'} />
    <meta property="og:site_name" content="庭 Niwa" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={OG_IMAGE.width} />
    <meta property="og:image:height" content={OG_IMAGE.height} />
    <meta property="og:image:alt" content={OG_IMAGE.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {Object.entries(pagefindMeta).map(([name, content]) => <meta data-pagefind-meta={`${name}[content]`} name={name} content={content} />)}
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="site-shell">
      <Sidebar navigation={navigation} />
      <main class="page-main" data-pagefind-body={pagefindBody || undefined} data-pagefind-ignore={!pagefindBody || undefined}>
        <slot />
      </main>
    </div>
    <SearchPalette tags={navigation.tags.map((tag) => tag.name)} client:idle />
  </body>
</html>
